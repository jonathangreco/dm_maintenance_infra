# Darkmira Service. Chaque service charge le .env rendu par user_data
# (parametre SSM des secrets + valeurs connues de Terraform). Aucun volume de
# donnees : tout etat vit en base (RDS PostgreSQL) ou sur S3. Les migrations
# n'ont qu'une voie : deploy.sh release.

x-awslogs-options: &awslogs-options
  awslogs-region: $${AWS_REGION:?AWS_REGION is required}
  awslogs-group: $${CLOUDWATCH_DOCKER_LOG_GROUP:?CLOUDWATCH_DOCKER_LOG_GROUP is required}
  awslogs-create-group: "false"

x-app: &app
  image: $${APP_IMAGE:?APP_IMAGE is required}
  restart: unless-stopped
  env_file: .env
  environment:
    APP_ENV: prod
    APP_DEBUG: "0"
    RUN_MIGRATIONS: "0"
  networks:
    - internal

services:
  app:
    <<: *app
    logging:
      driver: awslogs
      options:
        <<: *awslogs-options
        awslogs-stream: app
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      RUN_MIGRATIONS: "0"
      WARMUP_CACHE: "1"
    healthcheck:
      test: ["CMD", "php-fpm", "-t"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

  nginx:
    image: $${NGINX_IMAGE:?NGINX_IMAGE is required}
    restart: unless-stopped
    logging:
      driver: awslogs
      options:
        <<: *awslogs-options
        awslogs-stream: nginx
    depends_on:
      app:
        condition: service_healthy
    ports:
      - "$${NGINX_PORT:-8080}:80"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost/nginx-health | grep OK"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - internal

  # Un seul consommateur : le verrou optimiste d'une tentative refuse un
  # second worker concurrent sans le rendre utile.
  analyzer-worker:
    <<: *app
    command: ["php", "bin/console", "--no-debug", "messenger:consume", "analyzer", "scheduler_analyzer", "--memory-limit=512M"]
    logging:
      driver: awslogs
      options:
        <<: *awslogs-options
        awslogs-stream: analyzer-worker
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      RUN_MIGRATIONS: "0"
      WARMUP_CACHE: "0"
    depends_on:
      app:
        condition: service_healthy

  # Envoie les e-mails et tient le planning par defaut (fin des mandats,
  # catalogue des modeles d'IA).
  mail-worker:
    <<: *app
    command: ["php", "bin/console", "--no-debug", "messenger:consume", "mail", "scheduler_default", "--memory-limit=256M"]
    logging:
      driver: awslogs
      options:
        <<: *awslogs-options
        awslogs-stream: mail-worker
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      RUN_MIGRATIONS: "0"
      WARMUP_CACHE: "0"
    depends_on:
      app:
        condition: service_healthy
      mailer:
        condition: service_started

  # Sans domaine, aucun e-mail ne part : Mailpit les garde, consulte par
  # tunnel SSH (ssh -L 8025:localhost:8025 ec2-user@<ip>).
  mailer:
    image: axllent/mailpit:v1.27
    restart: unless-stopped
    ports:
      - "127.0.0.1:8025:8025"
    networks:
      - internal

networks:
  internal:
    driver: bridge
